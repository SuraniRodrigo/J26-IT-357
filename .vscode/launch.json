{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OPTICHAIN: Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}\\backend",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    },
    {
      "name": "OPTICHAIN: Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 127.0.0.1",
      "cwd": "${workspaceFolder}\\frontend"
    }
  ],
  "compounds": [
    {
      "name": "OPTICHAIN: Frontend + Backend",
      "configurations": [
        "OPTICHAIN: Backend (FastAPI)",
        "OPTICHAIN: Frontend (Vite)"
      ],
      "stopAll": true
    }
  ]
}
